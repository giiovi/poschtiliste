  "description": "ICT Modul M324 - DevOps-Prozesse - Webapp-Projektarbeit",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev:backend",
    "dev:backend": "npm run dev --workspace backend",
