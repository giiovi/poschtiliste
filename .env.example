# copy this file to .env and adjust the values. never commit a real .env file.

# runtime environment: development | production | test
NODE_ENV=development

# port the express backend listens on
PORT=3000

# development database
DATABASE_CLIENT=sqlite3
DATABASE_FILENAME=./data/development.sqlite

# test database (must remain separate from development data)
TEST_DATABASE_CLIENT=sqlite3
TEST_DATABASE_FILENAME=./data/test.sqlite
