# copy this file to .env and adjust the values. never commit a real .env file.

# runtime environment: development | production | test
NODE_ENV=development

# port the express backend listens on
PORT=3000

# secret used to sign the session cookie. use a long random value, e.g. `openssl rand -hex 32`
SESSION_SECRET=change-me-to-a-long-random-value

# false for local HTTP; use true when the application is served through HTTPS
SESSION_COOKIE_SECURE=false

# development database. for postgresql use DATABASE_CLIENT=pg with
# DATABASE_HOST, DATABASE_PORT (default 5432), DATABASE_NAME, DATABASE_USER and DATABASE_PASSWORD
DATABASE_CLIENT=sqlite3
DATABASE_FILENAME=./data/development.sqlite

# test database (must remain separate from development data)
TEST_DATABASE_CLIENT=sqlite3
TEST_DATABASE_FILENAME=./data/test.sqlite

# docker compose: host port of the application container
APP_PORT=3000

# docker compose: postgresql database container, the application connects with the same values
POSTGRES_DB=poschtiliste
POSTGRES_USER=poschtiliste
POSTGRES_PASSWORD=change-me-to-a-strong-password

# docker compose: named volume or host path (bind mount) for the postgresql data
DATA_VOLUME=poschtiliste-database

# docker compose: jenkins service (docker compose up jenkins), administrator login and host port
JENKINS_PORT=8080
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me-to-a-strong-password

# docker compose: group id of /var/run/docker.sock, 0 on docker desktop, `getent group docker` on linux
DOCKER_GID=0

# docker compose: github user and personal access token (public_repo scope) for the jenkins multibranch scan
GITHUB_USERNAME=
GITHUB_TOKEN=
